# ============================
# LLM 调用封装 (模拟)
# ============================
class LLMService:
    @staticmethod
    def invoke(prompt: str, system_prompt: str = "") -> str:
        """实际应调用 Claude/GPT 等大模型，这里返回模拟结果"""
        # 为了展示推理链，我们根据提示词内容返回有意义的JSON或文本
        if "最小权限" in prompt:
            return json.dumps({
                "risk": "中",
                "reasoning": "用户alice 90天未使用Admin权限，且当前部门职责不涉及基础设施管理",
                "suggestion": "降级为ReadOnly角色，并在30天后回收"
            })
        elif "WBS拆解" in prompt:
            return json.dumps({
                "tasks": [
                    {"id": "T1", "title": "支付服务接口开发", "role": "backend", "estimate": 3},
                    {"id": "T2", "title": "收银台UI重构", "role": "frontend", "estimate": 5}
                ],
                "ambiguities": ["是否支持分期付款?"],
                "risk": "第三方支付网关对接可能延迟"
            })
        elif "竞品战略" in prompt:
            return json.dumps({
                "strategic_moves": ["跟进降价", "强化性能优势", "加速AI功能上线"],
                "urgency": "高"
            })
        return "{}"

# ============================
# 长链推理辅助函数
# ============================
def deep_compliance_reasoning(finding: dict, knowledge: dict) -> dict:
    """
    合规长链推理:
    1. 获取资源关联的用户/部门信息
    2. 分析历史操作日志 (模拟)
    3. 结合公司政策进行多步因果推理
    4. 输出风险等级与修复建议
    """
    user = finding.get("resource")
    llm_input = f"""
    你是一名云安全专家。针对用户 {user} 的权限配置进行深度分析。
    当前发现: {json.dumps(finding, ensure_ascii=False)}
    公司政策要求所有用户遵循最小权限，且闲置权限超过90天应自动回收。
    已知该用户最后活跃时间: {knowledge.get('last_active', '未知')}
    请逐步推理:
    1. 其当前权限是否与其所属部门职责匹配?
    2. 是否存在过度授权或闲置权限?
    3. 综合给出风险等级(高/中/低)及具体修复步骤。
    """
    result = LLMService.invoke(llm_input)
    return json.loads(result) if isinstance(result, str) else result

def demand_deep_ambiguity_clarification(ambiguity: str, prd_context: str) -> dict:
    """需求模糊点的多步澄清链"""
    llm_input = f"""
    上下文: {prd_context}
    检测到的模糊表述: {ambiguity}
    请执行:
    1. 搜索知识库中相似历史需求，推测可能含义
    2. 列出需要向产品经理确认的具体问题
    3. 提供至少两种技术实现路径，并评估各自影响
    """
    return json.loads(LLMService.invoke(llm_input))

def competitor_strategy_reasoning(event: dict, knowledge: dict) -> dict:
    """竞品动态的深度推理链"""
    llm_input = f"""
    竞品事件: {json.dumps(event, ensure_ascii=False)}
    我方产品路线图: {knowledge.get('our_roadmap', [])}
    请串联分析:
    1. 结合对方近期融资/招聘推断其战略重心
    2. 评估该事件对我方的影响程度
    3. 生成三种不同策略选项 (跟进/差异化/忽略)
    """
    return json.loads(LLMService.invoke(llm_input))

