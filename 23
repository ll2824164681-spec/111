# ============================
# 全局状态定义 (跨三个业务域)
# ============================
class TaskType(str, Enum):
    COMPLIANCE = "compliance"
    REQUIREMENT = "requirement"
    COMPETITOR = "competitor"

class GlobalState(TypedDict):
    # 任务标识
    task_type: TaskType
    trigger_source: str              # e.g., "定时调度", "PRD上传", "竞品异动"
    
    # 各域共享数据
    knowledge_graph: dict            # 企业知识图谱 (云资源, 团队, 竞品等)
    event_stream: List[dict]         # 统一事件流
    
    # 合规审计域
    compliance_findings: List[dict]
    compliance_report: str
    compliance_score: float
    
    # 需求拆解域
    prd_raw: str                     # 原始PRD文本
    requirements_wbs: List[dict]     # 拆解后的WBS
    schedule_plan: dict              # 排期计划 {task_id: estimated_days}
    risk_notes: List[str]            # 风险注入说明
    
    # 竞品监控域
    competitor_events: List[dict]
    competitor_insights: dict        # 深度推理后的洞察
    strategic_options: List[str]     # 策略建议
    
    # 跨域协同标记
    cross_domain_actions: List[dict] # 动作：如"在迭代中插入安全任务"
    
    # 控制字段
    current_stage: str
    error_message: str

