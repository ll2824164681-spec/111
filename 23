# ----- 合规审计子图 -----
def compliance_data_collector(state: GlobalState) -> GlobalState:
    print("[Compliance Agent] 收集云资源快照...")
    state["event_stream"].append({"source": "cloud_api", "data": MockCloudAPI.get_iam_users()})
    state["event_stream"].append({"source": "cloud_api", "data": MockCloudAPI.get_s3_buckets()})
    return state

def compliance_rule_scanner(state: GlobalState) -> GlobalState:
    print("[Compliance Agent] 执行确定性规则扫描...")
    findings = []
    # S3公开桶
    for bucket in MockCloudAPI.get_s3_buckets():
        if bucket["public"]:
            findings.append({"resource": bucket["name"], "issue": "S3桶公开访问", "severity": "高", "type": "deterministic"})
    # IAM用户MFA
    for user in MockCloudAPI.get_iam_users():
        if not user["mfa"]:
            findings.append({"resource": user["name"], "issue": "未启用MFA", "severity": "高", "type": "deterministic"})
        # 模糊策略：管理员权限
        if "AdministratorAccess" in user["policies"]:
            findings.append({
                "resource": user["name"],
                "issue": "持有完整管理员权限",
                "severity": "待评估",
                "type": "fuzzy",
                "last_active": user.get("last_used")
            })
    state["compliance_findings"] = findings
    return state

def compliance_deep_reasoner(state: GlobalState) -> GlobalState:
    print("[Compliance Agent] 启动长链推理分析模糊策略...")
    clarified = []
    for f in state["compliance_findings"]:
        if f.get("type") == "fuzzy":
            # 注入更多上下文
            extra = {"last_active": f.get("last_active", "未知"), "dept": "工程部"}
            result = deep_compliance_reasoning(f, extra)
            f["severity"] = result.get("risk", "中")
            f["suggestion"] = result.get("suggestion", "")
            f["reasoning_chain"] = result.get("reasoning", "")
            clarified.append(f)
        else:
            clarified.append(f)
    state["compliance_findings"] = clarified
    return state

def compliance_evaluator_and_reporter(state: GlobalState) -> GlobalState:
    print("[Compliance Agent] 生成审计报告...")
    high = sum(1 for f in state["compliance_findings"] if f["severity"] == "高")
    score = max(0, 100 - high * 15)
    state["compliance_score"] = score
    state["compliance_report"] = json.dumps(state["compliance_findings"], ensure_ascii=False, indent=2)
    return state

def compliance_auto_remediator(state: GlobalState) -> GlobalState:
    print("[Compliance Agent] 执行可自动修复的项目...")
    for f in state["compliance_findings"]:
        if f["issue"] == "S3桶公开访问" and f["severity"] == "高":
            # 模拟关闭公共访问
            f["status"] = "已自动修复 (设置BlockPublicAccess)"
            state["cross_domain_actions"].append({
                "action": "create_security_task",
                "source": "compliance",
                "detail": f"安全加固: 关闭 {f['resource']} 公开访问",
                "assigned_to": "devops"
            })
    return state

# ----- 需求拆解子图 -----
def requirement_prd_receiver(state: GlobalState) -> GlobalState:
    # 实际中从消息队列或上传接口获取，这里模拟一份PRD
    state["prd_raw"] = "我们需要支持微信和支付宝两种支付方式，界面简洁，并确保交易安全。"
    return state

def requirement_multi_perspective_parser(state: GlobalState) -> GlobalState:
    print("[Requirement Agent] 多视角并行拆解...")
    # 模拟三个子Agent并行分析 (实际可用asyncio)
    backend_view = LLMService.invoke("作为后端架构师，将PRD拆解为后端任务列表")
    frontend_view = LLMService.invoke("作为前端架构师，将PRD拆解为前端任务列表")
    test_view = LLMService.invoke("作为QA，列出需要测试的用例和自动化点")
    
    # 协调Agent合并
    merged = json.loads(backend_view) if isinstance(backend_view, str) else backend_view
    state["requirements_wbs"] = merged.get("tasks", [])
    # 检测模糊点
    ambiguities = merged.get("ambiguities", [])
    for amb in ambiguities:
        detail = demand_deep_ambiguity_clarification(amb, state["prd_raw"])
        state["risk_notes"].append(f"模糊点澄清: {detail}")
    return state

def requirement_schedule_estimator(state: GlobalState) -> GlobalState:
    print("[Requirement Agent] 注入风险缓冲并生成排期...")
    capacity = MockJiraAPI.get_team_capacity()
    plan = {}
    for task in state["requirements_wbs"]:
        # 根据历史bug率增加缓冲
        hist = MockJiraAPI.get_issue_history(task.get("module","")) 
        buffer = 1.2 if hist["bug_rate"] > 0.05 else 1.0
        plan[task["id"]] = task["estimate"] * buffer
    state["schedule_plan"] = plan
    return state

def requirement_task_dispatcher(state: GlobalState) -> GlobalState:
    print("[Requirement Agent] 对接Jira创建Ticket...")
    # 模拟创建Jira Issue
    for task in state["requirements_wbs"]:
        print(f"创建任务: {task['title']}, 预估{state['schedule_plan'].get(task['id'])}天")
    return state

# ----- 竞品监控子图 -----
def competitor_listener(state: GlobalState) -> GlobalState:
    print("[Competitor Agent] 轮询竞品动态...")
    fresh = MockCompetitorAPI.fetch_rivals_info()
    state["competitor_events"] = fresh
    return state

def competitor_anomaly_detector(state: GlobalState) -> GlobalState:
    # 与基线对比，识别异常变动
    for event in state["competitor_events"]:
        if "降价" in event.get("latest_news",""):
            event["alert"] = "price_drop"
            state["competitor_events"].append(event)
    return state

def competitor_deep_strategist(state: GlobalState) -> GlobalState:
    print("[Competitor Agent] 深度推理对手战略意图...")
    for event in state["competitor_events"]:
        if event.get("alert") == "price_drop":
            added_context = MockCompetitorAPI.fetch_social_sentiment(event["name"])
            insight = competitor_strategy_reasoning(event, {"our_roadmap": ["Q4上线AI助手"]})
            state["competitor_insights"] = insight
            state["strategic_options"] = insight.get("strategic_moves", [])
            # 跨域联动：若策略建议新增功能，则通知需求域
            if "加速AI功能上线" in state["strategic_options"]:
                state["cross_domain_actions"].append({
                    "action": "create_requirement_story",
                    "source": "competitor",
                    "detail": "竞品降价+性能差评，建议提前AI助手功能",
                    "priority": "P0"
                })
    return state

def competitor_feedback_loop(state: GlobalState) -> GlobalState:
    print("[Competitor Agent] 策略效果回测...")
    # 实际中会监测执行后我方数据变化，这里模拟
    return state

# ============================
# 元调度 Agent (跨域路由与协同)
# ============================
def meta_orchestrator(state: GlobalState) -> GlobalState:
    """统一调度入口，根据触发源决定执行路径"""
    print(f"[Meta Agent] 接收任务类型: {state['task_type']}")
    
    if state["task_type"] == TaskType.COMPLIANCE:
        # 合规审计全流程
        state = compliance_data_collector(state)
        state = compliance_rule_scanner(state)
        state = compliance_deep_reasoner(state)
        state = compliance_evaluator_and_reporter(state)
        state = compliance_auto_remediator(state)
    
    elif state["task_type"] == TaskType.REQUIREMENT:
        state = requirement_prd_receiver(state)
        state = requirement_multi_perspective_parser(state)
        state = requirement_schedule_estimator(state)
        state = requirement_task_dispatcher(state)
    
    elif state["task_type"] == TaskType.COMPETITOR:
        state = competitor_listener(state)
        state = competitor_anomaly_detector(state)
        state = competitor_deep_strategist(state)
        state = competitor_feedback_loop(state)
    
    # 跨域协同动作处理
    if state["cross_domain_actions"]:
        print(f"[Meta Agent] 发现跨域动作: {state['cross_domain_actions']}")
        for action in state["cross_domain_actions"]:
            if "create_security_task" in action["action"]:
                print(f" --> 在需求待办中插入安全加固任务: {action['detail']}")
            elif "create_requirement_story" in action["action"]:
                print(f" --> 竞品驱动的需求已加入产品待办: {action['detail']}")
    return state

# ============================
# 构建 LangGraph 图
# ============================
def build_syncomind_graph():
    workflow = StateGraph(GlobalState)
    
    # 所有具体逻辑都集成在元调度节点中 (也可拆分成子图)
    workflow.add_node("meta", meta_orchestrator)
    
    # 入口直接到元调度
    workflow.set_entry_point("meta")
    workflow.add_edge("meta", END)
    
    return workflow.compile()

